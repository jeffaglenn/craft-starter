{######################
TEMPLATE SETTINGS
######################}

{% set buttons = buttons ?? null %}

{######################
END TEMPLATE SETTINGS
######################}

{% if buttons %}
    <div class="flex flex-wrap gap-2 items-center">
        {% for button in buttons.all() %}
            {% include '_components/_elements/button' with {
                button: button.linkField,
                small: button.smallButton,
            } %}
        {% endfor %}
    </div>
{% endif %}