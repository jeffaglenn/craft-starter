{######################
TEMPLATE SETTINGS
######################}

{# Extends #}
{% extends "_layouts/main" %}

{# Setting page classes #}
{% set bodyClass = entry.section.handle ~ '-' ~ entry.type %}

{######################
END TEMPLATE SETTINGS
######################}

{% block body %}
    {% include "_components/_sections/hero" with {
        hero: entry.hero.one(),
    } %}

    {% for item in entry.contentBuilder.all() %}
        {% include "_components/_content-builder/" ~ item.type | kebab %}
    {% endfor %}
{% endblock %}