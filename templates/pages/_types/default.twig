{######################
TEMPLATE SETTINGS
######################}

{# Extends #}
{% extends "_layouts/main" %}

{# Setting page classes #}
{% set bodyClass = entry.section.handle ~ '-' ~ entry.type %}

{######################
END TEMPLATE SETTINGS
######################}

{% block body %}
    {% for hero in entry.hero.collect() %}
        {% include '_components/_sections/hero/' ~ hero.type | kebab ignore missing %}
    {% endfor %}

    {% for item in entry.contentBuilder.all() %}
        {% include "_components/_content-builder/" ~ item.type | kebab ignore missing %}
    {% endfor %}
{% endblock %}