{
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "craftcms/ckeditor": "^5.3.1",
        "craftcms/cms": "^5.9.17",
        "craftcms/mailgun": "^3.1.0",
        "mmikkel/retcon": "^3.2.1",
        "nystudio107/craft-retour": "^5.0.14",
        "nystudio107/craft-seomatic": "^5.1.21",
        "nystudio107/craft-vite": "^5.0.1",
        "putyourlightson/craft-dashboard-begone": "^3.0.0",
        "putyourlightson/craft-sprig": "^3.7.2",
        "spacecatninja/imager-x": "^5.2.1",
        "spicyweb/craft-embedded-assets": "^5.4.2",
        "verbb/formie": "^3.1.18",
        "verbb/image-resizer": "^4.0.6",
        "verbb/navigation": "^3.0.20",
        "vlucas/phpdotenv": "^5.4.0"
    },
    "require-dev": {
        "craftcms/generator": "^2.0.0",
        "yiisoft/yii2-shell": "^2.0.3"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        }
    },
    "autoload": {
        "psr-4": {
            "modules\\ckeditorextras\\": "modules/CkeditorExtras/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.craftcms.com",
            "canonical": false
        }
    ]
}
