{
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "craftcms/ckeditor": "^5.7.0",
        "craftcms/cms": "^5.11.1",
        "craftcms/mailgun": "^3.1.0",
        "mmikkel/retcon": "^3.2.3",
        "nystudio107/craft-retour": "^5.0.14",
        "nystudio107/craft-seomatic": "^5.1.22",
        "nystudio107/craft-vite": "^5.0.2",
        "putyourlightson/craft-dashboard-begone": "^3.0.0",
        "putyourlightson/craft-sprig": "^3.7.3",
        "spacecatninja/imager-x": "^6.1.0",
        "spicyweb/craft-embedded-assets": "^5.4.9",
        "verbb/formie": "^3.1.38",
        "verbb/image-resizer": "^4.0.8",
        "verbb/navigation": "^3.0.20",
        "vlucas/phpdotenv": "^5.4.0"
    },
    "require-dev": {
        "craftcms/generator": "^2.0.0",
        "yiisoft/yii2-shell": "^2.0.3"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        }
    },
    "autoload": {
        "psr-4": {
            "modules\\ckeditorextras\\": "modules/CkeditorExtras/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.craftcms.com",
            "canonical": false
        }
    ]
}
